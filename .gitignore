# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# 部署产物 out/ 需要提交到 gh-pages 分支，
# 但在 main 分支上不追踪，避免污染源码历史。
# 见 README「部署到 GitHub Pages」一节。

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 卡牌原始素材（81MB PNG）。仓库只保留转换后的 public/cards/*.webp，
# 如需重新转换卡面，把 PNG 放回 Figure/ 后运行 `npm run cards:prepare`。
/Figure/

# 本地开发日志
*.log
dev.err
dev.err.log
prod.err
prod.err.log
